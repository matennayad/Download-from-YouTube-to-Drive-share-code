# ============================================================
# משתני סביבה לשרת ההורדות (מגדירים ב-Railway → Variables)
# הקובץ הזה הוא דוגמה בלבד - לא שמים בו ערכים אמיתיים ולא מעלים ערכים אמיתיים לגיט.
# ============================================================

# ---------- חובה ----------
# מפתח אקראי שהמצאת. אותו ערך בדיוק מוגדר גם ב-Code.gs (API_KEY)
API_KEY=CHANGE_ME_API_KEY

# כתובת ה-Web App של סקריפט ההורדות (Deploy → Web app), מסתיימת ב-/exec
DRIVE_TOKEN_BRIDGE_URL=https://script.google.com/macros/s/YOUR_WEB_APP_DEPLOYMENT_ID/exec

# ---------- מומלץ ----------
# מפתח נפרד לטופס החיפוש המאוחד (נשמר ב-Script Properties של טופס החיפוש בשם API_KEY)
UNIFIED_SEARCH_KEY=CHANGE_ME_SEARCH_KEY

# ---------- אופציונלי ----------
# תיקיית יעד בדרייב (החלק שאחרי folders/ בכתובת התיקייה)
DRIVE_FOLDER_ID=

# פרוקסי ישראלי - נדרש רק להורדות מכאן 11
KAN_PROXY_URL=

# עוגיות יוטיוב בפורמט Netscape - רק אם יוטיוב חוסם למרות ה-PO Token
YOUTUBE_COOKIES=

# שירות בדיקת חסימת נטפרי (מחזיר OPEN/LOCK/PENDING). ריק = כבוי
BLOCK_CHECK_BASE_URL=

# מפתח Gemini ליצירת תמונות (aistudio.google.com)
GEMINI_API_KEY=

# ---------- בוט טלגרם (docs/TELEGRAM_BOT_SETUP.md) ----------
TELEGRAM_BOT_TOKEN=
# מזהי טלגרם מספריים של מנהלים, מופרדים בפסיק
TELEGRAM_ADMIN_IDS=
# מזהה הגיליון של מערכת ההורדות (לשונית "מאושרים")
APPROVED_SHEET_ID=
# המייל שלך - הקבצים שמנהל מוריד דרך הבוט ישותפו אליו
BOT_OWNER_EMAIL=
# ערוצי טלגרם שהשירים מהם יורדו אוטומטית
TELEGRAM_SONGS_CHANNELS=

# ---------- דימון שירים מטלגרם (docs/TELEGRAM_SONGS_SETUP.md) ----------
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION_STRING=
TELEGRAM_CHANNELS=
TELEGRAM_NOTIFY_CHAT=

# ---------- גיבוי: חיבור OAuth ישיר לדרייב (לא נדרש כשהגשר פעיל) ----------
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
